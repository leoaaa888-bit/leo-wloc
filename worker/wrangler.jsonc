{
  // Pages 部署配置。
  //
  // 必须用默认文件名: `wrangler pages deploy` 不支持 -c/--config, 只会读当前目录
  // 下的 wrangler.jsonc / wrangler.json / wrangler.toml。Workers 那份因此改名成了
  // wrangler.workers.jsonc, 靠 -c 指定。
  //
  // compatibility_date 必须与 wrangler.workers.jsonc 保持一致 —— 两边跑的是同一份
  // 代码, 日期一旦漂开, Pages 和 Workers 就落在不同的运行时语义上。
  "name": "leo-wloc",
  "compatibility_date": "2026-08-05",
  "pages_build_output_dir": "./dist"
}
